# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/smsgateway?retryWrites=true&w=majority

# JWT (User Auth)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Upstash Redis
REDIS_URL=rediss://default:xxxxxxxxxxxx@xxxxxx.upstash.io:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT=

# Frontend public URL (used for generating links, emails, etc.)
# Dev:  http://localhost:5173
# Prod: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# CORS — comma-separated list of allowed origins
# Dev:  http://localhost:5173
# Prod: https://yourdomain.com
CORS_ORIGIN=http://localhost:5173,https://yourdomain.com

# Google OAuth 
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Google reCAPTCHA v3 
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY_HERE

# Resend (OTP emails for password reset)
RESEND_API_KEY=re_your_api_key_here
# For testing: SMS Gateway <onboarding@resend.dev>
RESEND_FROM=SMS Gateway <onboarding@resend.dev>
