
# Backend API base URL
# Dev:  leave EMPTY — Vite proxy handles /api, /auth, /admin
# Prod: https://api.yourdomain.com
VITE_API_BASE_URL=

# Displayed in API Key integration code snippets
# Dev:  http://localhost:3000
# Prod: https://api.yourdomain.com
VITE_API_SNIPPET_URL=http://localhost:3000

# Public URL of the frontend app
VITE_APP_PUBLIC_URL=http://localhost:5173

# Google OAuth Client ID for login
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Google reCAPTCHA v3 Site Key
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY_HERE

# Link to download the Android APK
VITE_APP_DOWNLOAD_URL=https://yourdomain.com/downloads/app-release.apk

# Support Email
VITE_SUPPORT_EMAIL=support@yourdomain.com
